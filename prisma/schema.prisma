// Prisma schema — MANSEDO
// Fuente: PostgreSQL. Cuatro modelos mínimos: Post, Category, ContactSubmission, AdminUser.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

model Category {
  id    String @id @default(cuid())
  slug  String @unique
  name  String
  posts Post[]

  @@map("categories")
}

model Post {
  id          String     @id @default(cuid())
  slug        String     @unique
  title       String
  excerpt     String
  content     String     @db.Text
  // URL externa opcional (legacy). Se mantiene por si el cliente quiere
  // referenciar una imagen ya alojada en un CDN.
  coverImage  String?
  // Imagen alojada dentro de la propia DB (recomendado): al subir se
  // optimiza con sharp y se sirve por /api/media/[id] con cache inmutable.
  coverAssetId String?
  coverAsset   MediaAsset? @relation("PostCover", fields: [coverAssetId], references: [id], onDelete: SetNull)
  author      String
  status      PostStatus @default(DRAFT)
  featured    Boolean    @default(false)
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([status, publishedAt])
  @@index([categoryId])
  @@map("posts")
}

model MediaAsset {
  id           String   @id @default(cuid())
  // Binario de la imagen ya optimizada (WebP por defecto).
  data         Bytes
  mimeType     String
  width        Int
  height       Int
  bytes        Int
  originalName String?
  createdAt    DateTime @default(now())

  posts Post[] @relation("PostCover")

  @@map("media_assets")
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  company   String?
  subject   String
  message   String   @db.Text
  ip        String?
  userAgent String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([ip, createdAt])
  @@map("contact_submissions")
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  @@map("admin_users")
}
