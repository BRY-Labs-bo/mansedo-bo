# =========================================
# MANSEDO — variables de entorno (ejemplo)
# Copiá este archivo como .env y completá los valores.
# =========================================

# ---- Base de datos (Postgres) ----
# Neon (recomendado en desarrollo y producción): pegá aquí el connection string.
# Ejemplo Neon: postgresql://user:pass@ep-xxxxx.aws.neon.tech/dbname?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/mansedo?schema=public"

# ---- Sesión del admin ----
# Cadena aleatoria de al menos 32 caracteres. Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="cambiar-por-un-secreto-largo-y-aleatorio-de-al-menos-32-chars"

# ---- Usuario admin inicial (usado sólo por el seed) ----
ADMIN_EMAIL="admin@mansedoconsulting.com"
ADMIN_PASSWORD="cambiar-en-produccion"

# ---- Correo (Resend, opcional) ----
# Si no está definido, el formulario igual guarda en DB; sólo se omite el envío de correo.
RESEND_API_KEY=""
# Correo desde el que sale el mail (dominio verificado en Resend)
RESEND_FROM="MANSEDO <no-reply@mansedoconsulting.com>"
# Destinatario del formulario de contacto
CONTACT_EMAIL="mansedo.srl@gmail.com"

# ---- Público ----
NEXT_PUBLIC_SITE_URL="https://www.mansedoconsulting.com"
# Número que abre el chat de WhatsApp (sin +, sin espacios). Por defecto: 70611882 con prefijo país 591.
NEXT_PUBLIC_WHATSAPP_NUMBER="59170611882"
